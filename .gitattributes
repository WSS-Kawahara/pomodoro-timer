# 改行コードの統一：テキストファイルは作業ツリー上で CRLF にそろえる
# （リポジトリ内部には LF で保存される）
* text=auto eol=crlf

*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.slnx      text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.config    text eol=crlf
*.json      text eol=crlf
*.xml       text eol=crlf
*.md        text eol=crlf
*.txt       text eol=crlf
*.yml       text eol=crlf
*.yaml      text eol=crlf
.gitignore      text eol=crlf
.gitattributes  text eol=crlf

# 内閣府の祝日CSV（Shift_JIS・CRLF）は配布元のバイト列をそのまま保つ
resources/syukujitsu.csv -text

