<Window x:Class="PomodoroTimer.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PomodoroTimer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="設定 - ポモドーロタイマー"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="TextBox">
            <Setter Property="Width" Value="80" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="就業開始時刻" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding WorkStartText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="1" Content="就業終了時刻" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkEndText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="2" Content="昼休憩の開始時刻" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LunchStartText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="3" Content="昼休憩の終了時刻" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LunchEndText, UpdateSourceTrigger=PropertyChanged}" />

            <Label Grid.Row="4" Content="長い休憩の長さ（分）" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LongBreakMinutesText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <TextBlock Text="時刻は「9:00」の形式で入力してください" Foreground="Gray" Margin="4,4,0,0" />

        <CheckBox Content="ミニ表示を表示する" IsChecked="{Binding ShowMiniWidget}" Margin="4,12,0,0" />

        <!-- 入力チェックのエラー -->
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="Firebrick" TextWrapping="Wrap" Margin="4,12,0,0"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Command="{Binding SaveCommand}" IsDefault="True" Width="80" Padding="0,4" />
            <Button Content="キャンセル" Command="{Binding CancelCommand}" IsCancel="True" Width="80" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
