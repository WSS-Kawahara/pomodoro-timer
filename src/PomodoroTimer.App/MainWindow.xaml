<Window x:Class="PomodoroTimer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PomodoroTimer.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="ポモドーロタイマー"
        Width="320" SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <StackPanel Margin="20">
        <!-- 状態 -->
        <TextBlock Text="{Binding PhaseText}"
                   FontSize="20" HorizontalAlignment="Center" />

        <!-- 残り時間（大きく） -->
        <TextBlock Text="{Binding RemainingText}"
                   FontSize="64" FontWeight="Bold" HorizontalAlignment="Center"
                   Margin="0,4,0,0" />

        <!-- サイクル数 -->
        <TextBlock Text="{Binding CycleText}"
                   FontSize="18" HorizontalAlignment="Center" />

        <!-- 祝日データの更新が必要なときだけ表示 -->
        <TextBlock Text="祝日データの更新が必要です"
                   Foreground="Firebrick" HorizontalAlignment="Center" Margin="0,12,0,0"
                   Visibility="{Binding NeedsHolidayDataUpdate, Converter={StaticResource BoolToVisibility}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
            <Button Content="{Binding OnOffButtonText}" Command="{Binding ToggleOnOffCommand}"
                    Width="100" Padding="0,4" />
            <Button Content="設定" Command="{Binding OpenSettingsCommand}"
                    Width="100" Padding="0,4" Margin="12,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
