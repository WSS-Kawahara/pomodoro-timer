<?xml version="1.0" encoding="utf-8"?>
<!--
  配布用の単一exeを作る発行プロファイル。
  使い方：dotnet publish src/PomodoroTimer.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- .NET を同梱し、インストールなしで動かす -->
    <SelfContained>true</SelfContained>
    <!-- 1つの exe にまとめる。WPF のネイティブDLLも exe に含める -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- デバッグ情報（PDB）を別ファイルにせず exe に入れる -->
    <DebugType>embedded</DebugType>
    <!-- 出力先はリポジトリ直下の publish\win-x64\（Git 管理外） -->
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
