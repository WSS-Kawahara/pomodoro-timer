<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- デバッグ情報（PDB）を dll に入れる。単一exeの発行で pdb が別ファイルとして出ないようにする -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- 内閣府の祝日CSV（Shift_JIS）。リポジトリ直下の resources から埋め込む -->
    <EmbeddedResource Include="..\..\resources\syukujitsu.csv" LogicalName="PomodoroTimer.Core.syukujitsu.csv" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Encoding.CodePages" Version="11.0.0" />
  </ItemGroup>

</Project>
